# ──────────────────────────────────────────────────────────────
# Igra KAS Bridge — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env for local development:
#   cp .env.example .env
#
# All variables are prefixed with VITE_ so Vite exposes them
# to the client bundle at build time.
# ──────────────────────────────────────────────────────────────

# ── Mainnet ──────────────────────────────────────────────────

# Minimum KAS per bridge transaction (whole KAS).
# Must be a positive integer. Invalid or missing values fall back to 10.
# Testnet and test-mainnet minimums are hardcoded to 1 KAS.
VITE_MAINNET_MIN_KAS=10

# Maximum KAS per bridge transaction (whole KAS).
# NOTE: Currently reserved — not yet wired into config.
# The bridge enforces no maximum by default (MAX_BRIDGE_AMOUNT_KAS = null).
# Uncomment and implement in config.ts if you need an upper limit.
# VITE_MAINNET_MAX_KAS=100000

# Bridge fee (mainnet only).
# Both FEE_KAS and FEE_ADDRESS must be set — if either is missing
# or FEE_KAS is not a positive integer, no fee is charged.
# The fee is added as a separate output in the bridge transaction.
VITE_MAINNET_FEE_KAS=1
VITE_MAINNET_FEE_ADDRESS=kaspa:your-fee-address-here

# ── Testnet ──────────────────────────────────────────────────

# Direct wRPC node URL for Kaspa Testnet-10.
# When set, the bridge connects directly to this node instead of
# using the Kaspa WASM Resolver (public node discovery).
#
# IMPORTANT: The value must be a wss:// URL. Browsers block plain
# ws:// connections when the page is served over HTTPS (mixed content).
#
# Typical setup:
#   1. Run a Kaspa testnet-10 node (wRPC Borsh on port 17210)
#   2. Put a TLS reverse proxy in front of it:
#      - Cloudflare (orange cloud) + nginx on origin (443 → 17210), or
#      - DNS-only + nginx + Let's Encrypt cert (443 → 17210)
#   3. Set the URL below to the public wss:// endpoint
#
# Leave empty or remove to fall back to the default Resolver.
VITE_TESTNET_NODE_URL=wss://your-testnet-node-url.com-or-ip-address
