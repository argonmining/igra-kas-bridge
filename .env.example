# Igra Bridge - Environment Variables
# Copy to .env for local development, or set in Railway dashboard for production.

# Mainnet bridge limits (whole KAS numbers, defaults: min=10, max=300)
VITE_MAINNET_MIN_KAS=10
VITE_MAINNET_MAX_KAS=300

# Mainnet bridge fee (optional — if either is missing, no fee is charged)
VITE_MAINNET_FEE_KAS=1
VITE_MAINNET_FEE_ADDRESS=kaspa:your-fee-address-here
